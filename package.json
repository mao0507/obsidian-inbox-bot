{
  "name": "obsidian-inbox-bot",
  "version": "1.0.0",
  "description": "Telegram bot that classifies incoming content with Claude and files it into an Obsidian vault",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "vault:sync": "node scripts/git-sync.js",
    "notebook": "node scripts/notebook-research-cli.js",
    "notebooklm:login": "node scripts/notebooklm-login.js",
    "service:install": "node scripts/service.js install",
    "service:uninstall": "node scripts/service.js uninstall",
    "service:logs": "node scripts/service.js logs",
    "service:restart": "node scripts/service.js restart",
    "migrate": "node scripts/migrate-vault.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@mozilla/readability": "^0.5.0",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "pm2": "^7.0.4",
    "telegraf": "^4.16.3"
  },
  "packageManager": "pnpm@10.33.0"
}
